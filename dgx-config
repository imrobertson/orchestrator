#!/bin/bash
# ==============================================================================
# 🚀 DGX ORCHESTRATOR WRAPPER (CONTAINER DELEGATE V2)
# ==============================================================================

CONTAINER_NAME="dgx-orchestrator-api"

# 1. Container Readiness Guard
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo "❌ ERROR: Container '${CONTAINER_NAME}' is not running!"
    echo "   [Fix]: Start stack: cd ~/docker/orchestrator && docker compose up -d"
    exit 1
fi

# 2. Flush Stale SSH Multiplex Sockets inside Container
docker exec "$CONTAINER_NAME" rm -f /root/.ssh/cm-* /tmp/cm-* 2>/dev/null

# 3. Dynamic TTY Allocation
DOCKER_TTY="-i"
if [ -t 0 ]; then
    DOCKER_TTY="-it"
fi

# 4. Smart Path Staging for --key Flags
PROCESSED_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --key)
            KEY_PATH="$2"
            if [ -f "$KEY_PATH" ]; then
                mkdir -p ~/.ssh
                cp "$KEY_PATH" ~/.ssh/.staged_auth_key.pub
                chmod 600 ~/.ssh/.staged_auth_key.pub
                PROCESSED_ARGS+=("--key" "/root/.ssh/.staged_auth_key.pub")
                shift 2
            else
                PROCESSED_ARGS+=("$1")
                shift
            fi
            ;;
        *)
            PROCESSED_ARGS+=("$1")
            shift
            ;;
    esac
done

# 5. Execute with Host User Context
exec docker exec $DOCKER_TTY \
    -e USER="${USER:-ian}" \
    "$CONTAINER_NAME" python3 dgx-orchestrator.py cli "${PROCESSED_ARGS[@]}"
